generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Flag config: the source of truth teams edit through the dashboard/API.
// ---------------------------------------------------------------------------

model Project {
  id           String        @id @default(cuid())
  key          String        @unique
  name         String
  createdAt    DateTime      @default(now())
  environments Environment[]
  flags        Flag[]
  auditLogs    AuditLog[]
}

model Environment {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  key        String
  name       String
  color      String   @default("#6366f1")
  // Which environment this is (prod gets guarded UI, etc.)
  production Boolean  @default(false)
  createdAt  DateTime @default(now())

  sdkKeys     SdkKey[]
  flagConfigs FlagConfig[]

  @@unique([projectId, key])
}

// A rotating SDK key that clients present to read a single environment's dataset.
model SdkKey {
  id            String      @id @default(cuid())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId String
  key           String      @unique
  kind          String      @default("server")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
}

model Flag {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  key         String
  name        String
  description String       @default("")
  // "boolean" | "string"
  kind        String       @default("boolean")
  // ordered list of possible values (JSON array)
  variations  Json
  // flag intended to be short-lived (release toggle) vs long-lived (ops/config)
  temporary   Boolean      @default(true)
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  configs     FlagConfig[]

  @@unique([projectId, key])
}

// Per-environment targeting configuration for a flag. This is what the
// evaluation engine consumes.
model FlagConfig {
  id            String      @id @default(cuid())
  flag          Flag        @relation(fields: [flagId], references: [id], onDelete: Cascade)
  flagId        String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId String

  // kill switch
  on            Boolean     @default(false)
  offVariation  Int         @default(0)
  // VariationOrRollout
  fallthrough   Json
  // Target[]  : individually targeted context keys
  targets       Json        @default("[]")
  // TargetingRule[] : attribute equals a value, or attribute ends with a value
  rules         Json        @default("[]")
  // Prerequisite[]
  prerequisites Json        @default("[]")
  // stable salt so bucketing is deterministic and independent per flag
  salt          String
  // bumped on every change; summed into the environment flag set version
  version       Int         @default(1)
  updatedAt     DateTime    @updatedAt

  @@unique([flagId, environmentId])
}

// ---------------------------------------------------------------------------
// Audit: append-only record of who changed what.
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  environmentId String?
  actor         String   @default("system")
  // e.g. "flag.updated", "flag.killswitch", "flag.enabled"
  action        String
  entityType    String
  entityId      String
  entityKey     String   @default("")
  comment       String   @default("")
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}
